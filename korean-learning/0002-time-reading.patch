diff --git a/lib/korean-time.ts b/lib/korean-time.ts
new file mode 100644
index 0000000..61ddc60
--- /dev/null
+++ b/lib/korean-time.ts
@@ -0,0 +1,33 @@
+// 시각 읽기: 시는 고유어 수(한 시, 두 시…), 분은 한자어 수(십 분, 이십 분…)를 써요.
+// 30분은 "반"이라고도 해요 (세 시 반). 한 문장에 두 숫자 체계가 섞이는 대표 예예요.
+import { nativeKorean } from "./native-number";
+import { numberToKorean } from "./korean-number";
+
+export function timeToKorean(h: number, m: number, useHalf = false): string {
+  if (!Number.isInteger(h) || h < 1 || h > 12) throw new RangeError("hour: 1-12");
+  if (!Number.isInteger(m) || m < 0 || m > 59) throw new RangeError("minute: 0-59");
+  const hour = `${nativeKorean(h, true)} 시`;
+  if (m === 0) return hour;
+  if (m === 30 && useHalf) return `${hour} 반`;
+  return `${hour} ${numberToKorean(m)} 분`;
+}
+
+// 약속·예약에서 자주 듣는 5분 단위 시각. 정답은 h*100+m (3:20 → 320)
+export function randomTime() {
+  const h = 1 + Math.floor(Math.random() * 12);
+  const m = Math.floor(Math.random() * 12) * 5;
+  const text = timeToKorean(h, m, m === 30 && Math.random() < 0.5);
+  return { n: h * 100 + m, text, label: `${h}:${String(m).padStart(2, "0")}` };
+}
+
+// "3:20", "3 20", "320", "3" 모두 받아요. 못 읽으면 null
+export function parseTime(input: string): number | null {
+  const parts = input.trim().split(/[^0-9]+/).filter(Boolean);
+  let h: number, m: number;
+  if (parts.length === 2) [h, m] = parts.map(Number);
+  else if (parts.length === 1 && parts[0].length <= 2) [h, m] = [Number(parts[0]), 0];
+  else if (parts.length === 1 && parts[0].length <= 4) [h, m] = [Number(parts[0].slice(0, -2)), Number(parts[0].slice(-2))];
+  else return null;
+  if (h < 1 || h > 12 || m > 59) return null;
+  return h * 100 + m;
+}
