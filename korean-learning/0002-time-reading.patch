diff --git a/lib/native-number.ts b/lib/native-number.ts
index 72a74d4..2d99d38 100644
--- a/lib/native-number.ts
+++ b/lib/native-number.ts
@@ -30,3 +30,15 @@ export function randomCount() {
   const n = 1 + Math.floor(Math.random() * c.max);
   return { counter: c, n, text: `${nativeKorean(n, true)} ${c.ko}` };
 }
+
+// 시각 읽기: "세 시 이십 분" — 시는 고유어 수, 분은 한자어 수예요. 30분은 "반"이라고도 해요.
+// 분은 실제 약속·예약처럼 5분 단위로 만들어요. 정답은 "3:20"처럼 비교해요.
+export function randomTime(sinoReader: (n: number) => string) {
+  const h = 1 + Math.floor(Math.random() * 12);
+  const m = Math.floor(Math.random() * 12) * 5;
+  const hour = `${nativeKorean(h, true)} 시`;
+  let text = hour;
+  if (m === 30 && Math.random() < 0.5) text = `${hour} 반`;
+  else if (m > 0) text = `${hour} ${sinoReader(m)} 분`;
+  return { h, m, text, answer: `${h}:${String(m).padStart(2, "0")}` };
+}
