+type Q = { n: number; text: string; unit: string; shown: string };
 
 // 단계별로 실제 가격처럼 보이는 숫자를 만들어요. (step 단위로 끊어서)
-const RANGES: Record<Exclude<Level, "native">, { min: number; max: number; step: number }> = {
+const RANGES: Record<Exclude<Level, "native" | "time">, { min: number; max: number; step: number }> = {
   easy: { min: 100, max: 9_900, step: 100 },
   medium: { min: 1_000, max: 99_500, step: 500 },
   hard: { min: 10_000, max: 990_000, step: 1_000 },
@@ -24,12 +24,30 @@ function randomQ(level: Level, won: string): Q {
   if (level === "native") {
     // 고유어 수: "사과 세 개"처럼 물건·사람·시각·나이를 세는 말
     const c = randomCount();
-    return { n: c.n, text: c.text, unit: c.counter.ko };
+    return { n: c.n, text: c.text, unit: c.counter.ko, shown: String(c.n) };
+  }
+  if (level === "time") {
+    // 시각: 시는 고유어(세 시), 분은 한자어(이십 분). 3:20 → n = 320 으로 비교해요
+    const t = randomTime(numberToKorean);
+    return { n: t.h * 100 + t.m, text: t.text, unit: "", shown: t.answer };
   }
   const { min, max, step } = RANGES[level];
   const count = Math.floor((max - min) / step) + 1;
   const n = min + Math.floor(Math.random() * count) * step;
-  return { n, text: `${numberToKorean(n)} 원`, unit: won };
+  return { n, text: `${numberToKorean(n)} 원`, unit: won, shown: formatNumber(n) };
+}
+
+// "3:20", "3시 20분", "15:20", "3" → 시×100+분 (12시간제로 맞춰요: 12시·15시 = 0시·3시)
+function parseTime(input: string): number | null {
+  const parts = input.match(/\d+/g);
+  if (!parts) return null;
+  let h: number;
+  let m = 0;
+  if (parts.length >= 2) [h, m] = [Number(parts[0]), Number(parts[1])];
+  else if (parts[0].length >= 3) [h, m] = [Math.floor(Number(parts[0]) / 100), Number(parts[0]) % 100];
+  else h = Number(parts[0]);
+  if (h > 24 || m > 59) return null;
+  return (h % 12) * 100 + m;
 }
 
