                 <p className="mt-1 text-sm">
                   {ui.reading}:{" "}
@@ -118,7 +144,7 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
                 </p>
               </div>
               <button type="button" onClick={next} className="w-full rounded-xl bg-brand py-3 font-semibold text-brand-ink">
