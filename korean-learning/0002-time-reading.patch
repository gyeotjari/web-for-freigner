diff --git a/lib/korean-time.ts b/lib/korean-time.ts
new file mode 100644
index 0000000..b184357
--- /dev/null
+++ b/lib/korean-time.ts
@@ -0,0 +1,28 @@
+// 시각 읽기: "세 시 이십 분"처럼 시는 고유어 수, 분은 한자어 수로 읽어요.
+// 근거: 국립국어원 표준국어대사전 '시'(고유어 수와 함께 씀)·'분'(한자어 수와 함께 씀).
+import { numberToKorean } from "./korean-number";
+import { nativeKorean } from "./native-number";
+
+// h: 1~12, m: 0~55 (5분 단위). 0분은 "세 시"처럼 분을 읽지 않아요.
+export function timeToKorean(h: number, m: number): string {
+  const hour = `${nativeKorean(h, true)} 시`;
+  return m === 0 ? hour : `${hour} ${numberToKorean(m)} 분`;
+}
+
+export function randomTime() {
+  const h = 1 + Math.floor(Math.random() * 12);
+  const m = Math.floor(Math.random() * 12) * 5;
+  return { h, m, text: timeToKorean(h, m), shown: `${h}:${String(m).padStart(2, "0")}` };
+}
+
+// "3:20", "3시 20분", "320", "0320" 모두 같은 답으로 봐요.
+export function parseTime(s: string): string | null {
+  const parts = s.match(/\d+/g);
+  if (!parts) return null;
+  let h: number, m: number;
+  if (parts.length >= 2) [h, m] = [Number(parts[0]), Number(parts[1])];
+  else if (parts[0].length >= 3) [h, m] = [Number(parts[0].slice(0, -2)), Number(parts[0].slice(-2))];
+  else [h, m] = [Number(parts[0]), 0];
+  if (h === 0 || h > 12 || m > 59) return null;
+  return `${h}:${String(m).padStart(2, "0")}`;
+}
