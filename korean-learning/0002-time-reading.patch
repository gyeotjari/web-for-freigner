diff --git a/lib/korean-time.ts b/lib/korean-time.ts
new file mode 100644
index 0000000..adc8a63
--- /dev/null
+++ b/lib/korean-time.ts
@@ -0,0 +1,31 @@
+// 시각 읽기: "세 시 이십 분"처럼 '시'는 고유어 수, '분'은 한자어 수로 읽어요.
+// 30분은 흔히 "반"이라고도 해요 (세 시 반). 0분은 "세 시"만 말해요.
+import { nativeKorean } from "@/lib/native-number";
+import { numberToKorean } from "@/lib/korean-number";
+
+export function timeToKorean(h: number, m: number, useBan = false): string {
+  if (!Number.isInteger(h) || h < 1 || h > 12) throw new RangeError("hour: 1-12");
+  if (!Number.isInteger(m) || m < 0 || m > 59) throw new RangeError("minute: 0-59");
+  const hour = `${nativeKorean(h, true)} 시`;
+  if (m === 0) return hour;
+  if (m === 30 && useBan) return `${hour} 반`;
+  return `${hour} ${numberToKorean(m)} 분`;
+}
+
+// 5분 단위 시각 (예약·약속에서 자주 듣는 꼴). 30분이면 절반은 "반"으로 읽어요.
+export function randomTime() {
+  const h = 1 + Math.floor(Math.random() * 12);
+  const m = Math.floor(Math.random() * 12) * 5;
+  return { h, m, text: timeToKorean(h, m, Math.random() < 0.5) };
+}
+
+// 입력 "3:20", "3 20", "320", "3시 20분", "3" → {h, m}. 못 알아보면 null.
+export function parseTime(input: string): { h: number; m: number } | null {
+  const parts = input.match(/\d+/g);
+  if (!parts) return null;
+  if (parts.length >= 2) return { h: Number(parts[0]), m: Number(parts[1]) };
+  const d = parts[0];
+  if (d.length <= 2) return { h: Number(d), m: 0 };
+  if (d.length <= 4) return { h: Number(d.slice(0, -2)), m: Number(d.slice(-2)) };
+  return null;
+}
