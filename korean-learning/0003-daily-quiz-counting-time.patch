 import { speakKorean } from "@/lib/speech";
 import { useIsClient, useStoredJSON } from "@/lib/storage";
@@ -10,7 +11,7 @@ import type { ToolUi } from "@/lib/content";
 
 type Ui = ToolUi<"daily-quiz">;
 type Item = { ko: string; meaning: string };
-type Question = { type: "meaning" | "sign" | "number"; prompt: string; speak?: string; answer: string; choices: string[] };
+type Question = { type: "meaning" | "sign" | "number" | "count" | "time"; prompt: string; speak?: string; answer: string; choices: string[] };
 type Results = Record<string, { score: number; picks: string[] }>;
 
 const TOTAL = 5;
@@ -26,7 +27,54 @@ function hash(s: string) {
   return h >>> 0;
 }
 
-// 날짜로 정해지는 오늘의 5문제: 문장 2 + 간판 2 + 가격 1
+// 숫자 문제 하나: 날마다 가격 / 고유어 세기 / 시각 중 하나를 돌아가며 내요.
+// 보기에는 외국인이 실제로 많이 틀리는 말(삼 개, 삼 시, 셋 개 등)을 넣어요.
+function numberQuestion(rand: () => number): Question {
+  const kind = Math.floor(rand() * 3);
+  if (kind === 1) {
+    // 세기: 3개 → 세 개 (한자어 '삼 개', 줄이지 않은 '셋 개'가 흔한 실수)
+    const units = COUNTERS.filter((c) => c.id !== "hour" && c.id !== "age");
+    const c = units[Math.floor(rand() * units.length)];
+    const n = 1 + Math.floor(rand() * 5); // 1~5: 줄어든 꼴(한·두·세·네)이 나오는 수
+    const right = `${nativeKorean(n, true)} ${c.ko}`;
+    // 틀린 보기 후보 (앞에 있을수록 흔한 실수). 다섯은 줄어든 꼴이 같아서 중복을 빼고 앞에서 3개만 써요.
+    const wrongs = [
+      `${sinoKorean(n)} ${c.ko}`,
+      `${nativeKorean(n)} ${c.ko}`,
+      `${nativeKorean(n === 5 ? 4 : n + 1, true)} ${c.ko}`,
+      `${nativeKorean(n + 2, true)} ${c.ko}`,
+    ].filter((w) => w !== right);
+    return { type: "count", prompt: `${n}${c.ko}`, answer: right, choices: shuffle([right, ...wrongs.slice(0, 3)], rand) };
+  }
+  if (kind === 2) {
+    // 시각: 3:20 → 세 시 이십 분 (시를 한자어로 읽는 '삼 시'가 흔한 실수)
+    const h = 1 + Math.floor(rand() * 12);
+    const m = (1 + Math.floor(rand() * 11)) * 5; // 5~55분
+    const right = timeKorean(h, m);
+    const wrongs = [
+      `${sinoKorean(h)} 시 ${sinoKorean(m)} 분`,
+      `${nativeKorean(h, true)} 시 ${nativeKorean(m, true)} 분`,
+      timeKorean(h === 12 ? 1 : h + 1, m),
+    ];
+    return {
+      type: "time",
+      prompt: `🕒 ${h}:${String(m).padStart(2, "0")}`,
+      answer: right,
+      choices: shuffle([right, ...wrongs.filter((w) => w !== right)].slice(0, 4), rand),
+    };
+  }
+  // 가격 문제: 헷갈리기 쉬운 비슷한 숫자를 보기로 넣어요
+  const price = (Math.floor(rand() * 90) + 10) * 500; // 5,000 ~ 49,500
+  const near = [price + 1000, price - 500, price * 10, price + 10000].filter((n) => n > 0 && n !== price);
+  return {
+    type: "number",
+    prompt: `₩${formatNumber(price)}`,
+    answer: `${numberToKorean(price)} 원`,
+    choices: shuffle([price, ...shuffle(near, rand).slice(0, 3)], rand).map((n) => `${numberToKorean(n)} 원`),
+  };
+}
+
+// 날짜로 정해지는 오늘의 5문제: 문장 2 + 간판 2 + 숫자 1 (가격·세기·시각 중 하나)
 function buildQuiz(date: string, phrasePool: Item[], signPool: Item[]): Question[] {
   const rand = seededRandom(hash(date));
   const phrases = shuffle(phrasePool, rand).slice(0, 2);
@@ -47,15 +95,7 @@ function buildQuiz(date: string, phrasePool: Item[], signPool: Item[]): Question
       choices: makeChoices(s.meaning, signPool.map((x) => x.meaning), rand),
     })),
   ];
-  // 가격 문제: 헷갈리기 쉬운 비슷한 숫자를 보기로 넣어요
-  const price = (Math.floor(rand() * 90) + 10) * 500; // 5,000 ~ 49,500
-  const near = [price + 1000, price - 500, price * 10, price + 10000].filter((n) => n > 0 && n !== price);
-  qs.push({
-    type: "number",
-    prompt: `₩${formatNumber(price)}`,
-    answer: `${numberToKorean(price)} 원`,
-    choices: shuffle([price, ...shuffle(near, rand).slice(0, 3)], rand).map((n) => `${numberToKorean(n)} 원`),
-  });
+  qs.push(numberQuestion(rand));
   return shuffle(qs, rand).slice(0, TOTAL);
 }
 
@@ -147,7 +187,16 @@ function QuizBody({ ui, phrasePool, signPool }: { ui: Ui; phrasePool: Item[]; si
 
   const q = questions[index];
   const picked = picks[index];
-  const label = q.type === "meaning" ? ui.typeMeaning : q.type === "sign" ? ui.typeSign : ui.typeNumber;
+  const label =
+    q.type === "meaning"
+      ? ui.typeMeaning
+      : q.type === "sign"
+        ? ui.typeSign
+        : q.type === "count"
+          ? ui.typeCount
+          : q.type === "time"
+            ? ui.typeTime
+            : ui.typeNumber;
   const isLast = index === TOTAL - 1;
 
   function choose(c: string) {
