diff --git a/lib/particle.ts b/lib/particle.ts
new file mode 100644
index 0000000..a8e47ad
--- /dev/null
+++ b/lib/particle.ts
@@ -0,0 +1,13 @@
+// 받침에 따라 붙는 말(조사)을 골라요. 한글 음절 코드: (코드 - 0xAC00) % 28 = 받침 번호 (0 = 받침 없음, 8 = ㄹ)
+export function finalConsonantIndex(word: string): number {
+  const last = word.trim().slice(-1);
+  const code = last.charCodeAt(0) - 0xac00;
+  if (code < 0 || code > 11171) return 0; // 한글이 아니면 받침 없음으로 봐요
+  return code % 28;
+}
+
+// (으)로: 받침이 있으면 "으로", 받침이 없거나 ㄹ 받침이면 "로"
+export function withEuro(word: string): string {
+  const f = finalConsonantIndex(word);
+  return word + (f === 0 || f === 8 ? "로" : "으로");
+}
