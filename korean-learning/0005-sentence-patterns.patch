@@ -0,0 +1,88 @@
+"use client";
+
+import { useState } from "react";
+import { withEuro } from "@/lib/particle";
+import { speakKorean } from "@/lib/speech";
+import { useStoredJSON } from "@/lib/storage";
+import type { ToolUi } from "@/lib/content";
+
+type Ui = ToolUi<"sentence-patterns">;
+type Word = { ko: string; meaning: string };
+export type Frame = { id: string; pattern: string; meaning: string; tip: string; words: Word[] };
+
+// 틀의 {N} 자리에 단어를 넣어요. {N}(으)로 는 받침에 맞게 으로/로를 붙여요.
+export function fillPattern(pattern: string, word: string) {
+  return pattern.replace("{N}(으)로", withEuro(word)).replace("{N}", word);
+}
+
+export function SentenceBuilder({ ui, frames }: { ui: Ui; frames: Frame[] }) {
+  const [frameId, setFrameId] = useStoredJSON("kt:patterns:frame", frames[0].id);
+  const frame = frames.find((f) => f.id === frameId) ?? frames[0];
+  const [wordIndex, setWordIndex] = useState(0);
+  const word = frame.words[wordIndex] ?? frame.words[0];
+  const sentence = fillPattern(frame.pattern, word.ko);
+
+  return (
+    <div className="space-y-4">
+      {/* 1. 문장 틀 고르기 */}
+      <section>
+        <h2 className="mb-2 font-bold">1. {ui.pickPattern}</h2>
+        <div className="flex flex-wrap gap-2">
+          {frames.map((f) => (
+            <button
+              key={f.id}
+              type="button"
+              onClick={() => {
+                setFrameId(f.id);
+                setWordIndex(0);
+              }}
+              aria-pressed={f.id === frame.id}
+              className={`rounded-full border-2 px-3 py-1.5 font-semibold ${f.id === frame.id ? "border-brand bg-brand-soft" : "border-line bg-card"}`}
+            >
+              <span lang="ko">{f.pattern.replace("{N}(으)로", "○○(으)로").replace("{N}", "○○")}</span>
+            </button>
+          ))}
+        </div>
+        <p className="mt-2 text-sm text-muted">
+          {frame.meaning.replace("{N}", "○○")} · {frame.tip}
+        </p>
+      </section>
+
+      {/* 2. 단어 고르기 */}
+      <section>
+        <h2 className="mb-2 font-bold">2. {ui.pickWord}</h2>
+        <div className="grid grid-cols-2 gap-2 sm:grid-cols-3">
+          {frame.words.map((w, i) => (
+            <button
+              key={w.ko}
+              type="button"
+              onClick={() => {
+                setWordIndex(i);
+                speakKorean(fillPattern(frame.pattern, w.ko));
+              }}
+              aria-pressed={i === wordIndex}
+              className={`rounded-xl border-2 p-2 text-left ${i === wordIndex ? "border-brand bg-brand-soft" : "border-line bg-card"}`}
+            >
+              <span lang="ko" className="block font-bold">
+                {w.ko}
+              </span>
+              <span className="block text-xs text-muted">{w.meaning}</span>
+            </button>
+          ))}
+        </div>
+      </section>
+
+      {/* 3. 완성된 문장 (직원에게 보여 줄 수 있게 크게) */}
+      <section aria-live="polite" className="rounded-2xl border-2 border-brand bg-card p-5 text-center">
+        <p className="text-sm font-semibold text-muted">{ui.result}</p>
+        <p lang="ko" className="mt-1 text-3xl font-bold">
+          {sentence}
+        </p>
+        <p className="mt-1 text-sm">{frame.meaning.replace("{N}", word.meaning)}</p>
+        <button type="button" onClick={() => speakKorean(sentence)} className="mt-3 w-full rounded-xl bg-brand py-3 font-semibold text-brand-ink">
+          🔊 {ui.listen}
+        </button>
+      </section>
+    </div>
+  );
+}
diff --git a/app/[lang]/tools/sentence-patterns/page.tsx b/app/[lang]/tools/sentence-patterns/page.tsx
new file mode 100644
index 0000000..bd029b9
--- /dev/null
+++ b/app/[lang]/tools/sentence-patterns/page.tsx
@@ -0,0 +1,32 @@
+import type { Metadata } from "next";
+import { pick, type Locale } from "@/lib/i18n";
+import { toolMeta } from "@/lib/data";
+import { getToolContent } from "@/lib/content";
+import { ToolLayout } from "@/components/ToolLayout";
+import data from "@/data/sentence-patterns.json";
+import { SentenceBuilder } from "./SentenceBuilder";
+
+const SLUG = "sentence-patterns";
+
+export async function generateMetadata({ params }: PageProps<"/[lang]/tools/sentence-patterns">): Promise<Metadata> {
+  return toolMeta(SLUG, (await params).lang as Locale);
+}
+
+export default async function Page({ params }: PageProps<"/[lang]/tools/sentence-patterns">) {
+  const lang = (await params).lang as Locale;
+  const content = getToolContent(SLUG, lang);
+  // 한국어 화면에서는 뜻 대신 영어 뜻을 보여 줘요 (한국어 뜻은 문장 그대로라 의미가 없어요)
+  const meaningLang: Locale = lang === "ko" ? "en" : lang;
+  const frames = data.frames.map((f) => ({
+    id: f.id,
+    pattern: f.pattern,
+    meaning: pick(f.meaning, meaningLang),
+    tip: pick(f.tip, lang),
+    words: f.words.map((w) => ({ ko: w.ko, meaning: pick(w.meaning, meaningLang) })),
+  }));
+  return (
+    <ToolLayout lang={lang} slug={SLUG} about={content.about} faq={content.faq} sources={[]}>
+      <SentenceBuilder ui={content.ui} frames={frames} />
+    </ToolLayout>
+  );
+}
