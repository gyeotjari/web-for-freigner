+  const menuWords = hangul.menuWords.map((w) => ({ id: w.id, ko: w.ko, roman: w.roman, meaning: pick(w.meaning, lang), example: w.example }));
+
   return (
     <ToolLayout
       lang={lang}
@@ -42,7 +45,7 @@ export default async function Page({ params }: PageProps<"/[lang]/tools/hangul-r
         { label: "National Institute of Korean Language — Standard Pronunciation Rules", url: hangul.soundRulesSource.url, lastChecked: hangul.soundRulesSource.lastChecked },
       ]}
     >
-      <HangulReader ui={content.ui} groups={groups} signs={signs} soundRules={soundRules} />
+      <HangulReader ui={content.ui} groups={groups} signs={signs} soundRules={soundRules} menuWords={menuWords} />
     </ToolLayout>
   );
 }
