+++ b/app/[lang]/tools/hangul-reader/HangulReader.tsx
@@ -10,6 +10,7 @@ type Ui = ToolUi<"hangul-reader">;
 type Letter = { char: string; name: string; roman: string; example: string };
 type Group = { id: string; name: string; letters: Letter[] };
 type Sign = { id: string; ko: string; roman: string; meaning: string };
+type MenuWord = { id: string; ko: string; roman: string; meaning: string; example: string };
 type SoundRule = { id: string; name: string; explain: string; examples: { written: string; said: string }[] };
 
 export function HangulReader({
@@ -17,11 +18,13 @@ export function HangulReader({
   groups,
   signs,
   soundRules,
+  menuWords,
 }: {
   ui: Ui;
   groups: Group[];
   signs: Sign[];
   soundRules: SoundRule[];
+  menuWords: MenuWord[];
 }) {
   const isClient = useIsClient();
   const [last, setLast] = useState<Letter | null>(null);
@@ -71,6 +74,8 @@ export function HangulReader({
 
       <SoundRules ui={ui} rules={soundRules} />
 
+      <MenuWords ui={ui} words={menuWords} />
+
       <section className="rounded-2xl border border-line bg-card p-4">
         <h2 className="mb-3 text-lg font-bold">🔤 {ui.quizTitle}</h2>
         {/* 문제 순서는 무작위라서 브라우저에서만 만들어요 */}
@@ -243,3 +248,34 @@ function SoundRules({ ui, rules }: { ui: Ui; rules: SoundRule[] }) {
     </section>
   );
 }
+
+// 메뉴판 읽기: 음식 이름 끝의 요리 방법(볶음·구이·찌개…) 12개. 예시 음식을 누르면 들려요.
+// 휴대폰에서 길어지지 않게 접어 둬요.
+function MenuWords({ ui, words }: { ui: Ui; words: MenuWord[] }) {
+  return (
+    <details className="rounded-xl border border-line bg-card p-3">
+      <summary className="cursor-pointer font-bold">🍲 {ui.menuTitle}</summary>
+      <p className="mt-2 text-sm text-muted">{ui.menuHint}</p>
+      <ul className="mt-2 grid grid-cols-2 gap-2">
+        {words.map((w) => (
+          <li key={w.id} className="rounded-lg border border-line p-2">
+            <p>
+              <span lang="ko" className="text-lg font-bold">
+                {w.ko}
+              </span>{" "}
+              <span className="text-xs text-muted">{w.roman}</span>
+            </p>
+            <p className="text-sm">{w.meaning}</p>
+            <button
+              type="button"
+              onClick={() => speakKorean(w.example)}
+              className="mt-1 rounded-lg border border-line px-2 py-0.5 text-sm"
+            >
+              🔊 <span lang="ko">{w.example}</span>
+            </button>
+          </li>
+        ))}
+      </ul>
+    </details>
+  );
+}
