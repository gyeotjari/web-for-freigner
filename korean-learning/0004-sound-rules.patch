+function articleLabel(nums: number[], lang: Locale) {
+  const n = nums.join("·");
+  if (lang === "ko") return `제${n}항`;
+  if (lang === "zh") return `第${n}条`;
+  return `${nums.length > 1 ? "Articles" : "Article"} ${n}`;
+}
+
 export default async function Page({ params }: PageProps<"/[lang]/tools/hangul-reader">) {
   const lang = (await params).lang as Locale;
   const content = getToolContent(SLUG, lang);
@@ -19,6 +26,14 @@ export default async function Page({ params }: PageProps<"/[lang]/tools/hangul-r
   const meaningLang: Locale = lang === "ko" ? "en" : lang;
   const groups = hangul.groups.map((g) => ({ id: g.id, name: pick(g.name, lang), letters: g.letters }));
   const signs = hangul.signs.map((s) => ({ id: s.id, ko: s.ko, roman: s.roman, meaning: pick(s.meaning, meaningLang) }));
+  const rules = hangul.soundRules.map((r) => ({
+    id: r.id,
+    // 조항 번호: 제18항 / Article 18 / 第18条
+    article: articleLabel(r.articles, lang),
+    title: pick(r.title, lang),
+    explain: pick(r.explain, lang),
+    examples: r.examples,
+  }));
 
   return (
     <ToolLayout
@@ -33,7 +48,7 @@ export default async function Page({ params }: PageProps<"/[lang]/tools/hangul-r
         { label: "Socinet (Ministry of Justice) — KIIP class fees from 2025", url: "https://www.socinet.go.kr/soci/comm/board/BoardPopup3.jsp", lastChecked: "2026-10-28" },
       ]}
     >
-      <HangulReader ui={content.ui} groups={groups} signs={signs} />
+      <HangulReader ui={content.ui} groups={groups} signs={signs} rules={rules} />
     </ToolLayout>
   );
 }
