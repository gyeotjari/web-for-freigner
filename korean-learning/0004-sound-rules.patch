@@ -10,8 +10,9 @@ type Ui = ToolUi<"hangul-reader">;
 type Letter = { char: string; name: string; roman: string; example: string };
 type Group = { id: string; name: string; letters: Letter[] };
 type Sign = { id: string; ko: string; roman: string; meaning: string };
+export type SoundRule = { id: string; article: string; title: string; explain: string; examples: { word: string; sound: string }[] };
 
-export function HangulReader({ ui, groups, signs }: { ui: Ui; groups: Group[]; signs: Sign[] }) {
+export function HangulReader({ ui, groups, signs, rules }: { ui: Ui; groups: Group[]; signs: Sign[]; rules: SoundRule[] }) {
   const isClient = useIsClient();
   const [last, setLast] = useState<Letter | null>(null);
 
@@ -58,6 +59,8 @@ export function HangulReader({ ui, groups, signs }: { ui: Ui; groups: Group[]; s
         </section>
       ))}
 
+      <SoundRules ui={ui} rules={rules} />
+
       <section className="rounded-2xl border border-line bg-card p-4">
         <h2 className="mb-3 text-lg font-bold">🔤 {ui.quizTitle}</h2>
         {/* 문제 순서는 무작위라서 브라우저에서만 만들어요 */}
@@ -146,3 +149,44 @@ function SignQuiz({ ui, signs }: { ui: Ui; signs: Sign[] }) {
     </div>
   );
 }
+
+// 소리 규칙: 글자와 실제 소리가 다른 대표 경우 (표준 발음법). 단어를 누르면 읽어 줘요.
+function SoundRules({ ui, rules }: { ui: Ui; rules: SoundRule[] }) {
+  return (
+    <section>
+      <h2 className="mb-1 text-lg font-bold">🗣️ {ui.soundTitle}</h2>
+      <p className="mb-2 text-sm text-muted">{ui.soundHint}</p>
+      <div className="space-y-2">
+        {rules.map((r) => (
+          <details key={r.id} className="rounded-xl border border-line bg-card p-3 open:border-brand">
+            <summary className="cursor-pointer font-semibold">{r.title}</summary>
+            <p className="mt-2 text-sm">{r.explain}</p>
+            <ul className="mt-2 grid grid-cols-2 gap-2">
+              {r.examples.map((e) => (
+                <li key={e.word}>
+                  <button
+                    type="button"
+                    onClick={() => speakKorean(e.word)}
+                    aria-label={`${e.word} ${ui.listen}`}
+                    className="w-full rounded-lg border border-line bg-bg px-2 py-2 text-left hover:border-brand"
+                  >
+                    <span lang="ko" className="font-bold">
+                      {e.word}
+                    </span>{" "}
+                    <span lang="ko" className="text-brand">
+                      [{e.sound}]
+                    </span>{" "}
+                    🔊
+                  </button>
+                </li>
+              ))}
+            </ul>
+            <p className="mt-2 text-xs text-muted">
+              {ui.soundSource} {r.article}
+            </p>
+          </details>
+        ))}
+      </div>
+    </section>
+  );
+}
