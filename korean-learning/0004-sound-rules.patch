 type Sign = { id: string; ko: string; roman: string; meaning: string };
+type SoundRule = { id: string; name: string; explain: string; examples: { written: string; said: string }[] };
 
-export function HangulReader({ ui, groups, signs }: { ui: Ui; groups: Group[]; signs: Sign[] }) {
+export function HangulReader({
+  ui,
+  groups,
+  signs,
+  soundRules,
+}: {
+  ui: Ui;
+  groups: Group[];
+  signs: Sign[];
+  soundRules: SoundRule[];
+}) {
   const isClient = useIsClient();
   const [last, setLast] = useState<Letter | null>(null);
 
@@ -58,6 +69,8 @@ export function HangulReader({ ui, groups, signs }: { ui: Ui; groups: Group[]; s
         </section>
       ))}
 
+      <SoundRules ui={ui} rules={soundRules} />
+
       <section className="rounded-2xl border border-line bg-card p-4">
         <h2 className="mb-3 text-lg font-bold">🔤 {ui.quizTitle}</h2>
         {/* 문제 순서는 무작위라서 브라우저에서만 만들어요 */}
@@ -146,3 +159,44 @@ function SignQuiz({ ui, signs }: { ui: Ui; signs: Sign[] }) {
     </div>
   );
 }
+
+// 받침 소리 규칙: 글자는 읽을 수 있는데 들으면 다르게 들리는 이유. 규칙마다 예시 단어 3개, 누르면 들려요.
+// 휴대폰에서 길어지지 않게 첫 규칙만 펼치고 나머지는 접어 둬요.
+function SoundRules({ ui, rules }: { ui: Ui; rules: SoundRule[] }) {
+  return (
+    <section>
+      <h2 className="mb-1 font-bold">🗣️ {ui.soundTitle}</h2>
+      <p className="mb-2 text-sm text-muted">{ui.soundHint}</p>
+      <div className="space-y-2">
+        {rules.map((r, i) => (
+          <details key={r.id} open={i === 0} className="rounded-xl border border-line bg-card p-3">
+            <summary className="cursor-pointer font-semibold">{r.name}</summary>
+            <p className="mt-2 text-sm">{r.explain}</p>
+            <ul className="mt-2 space-y-1">
+              {r.examples.map((e) => (
+                <li key={e.written}>
+                  <button
+                    type="button"
+                    onClick={() => speakKorean(e.written)}
+                    className="flex w-full items-center gap-2 rounded-lg bg-bg px-3 py-2 text-left"
+                  >
+                    <span lang="ko" className="text-lg font-bold">
+                      {e.written}
+                    </span>
+                    <span className="text-xs text-muted">{ui.soundAs}</span>
+                    <span lang="ko" className="text-lg font-bold text-brand">
+                      [{e.said}]
+                    </span>
+                    <span className="ml-auto" aria-hidden>
+                      🔊
+                    </span>
+                  </button>
+                </li>
+              ))}
+            </ul>
+          </details>
+        ))}
+      </div>
+    </section>
+  );
+}
