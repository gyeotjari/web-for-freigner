diff --git a/app/[lang]/tools/korean-politeness/page.tsx b/app/[lang]/tools/korean-politeness/page.tsx
index 316eee9..74d6520 100644
--- a/app/[lang]/tools/korean-politeness/page.tsx
+++ b/app/[lang]/tools/korean-politeness/page.tsx
@@ -15,6 +15,14 @@ export async function generateMetadata({ params }: PageProps<"/[lang]/tools/kore
 type Level = { id: "casual" | "polite" | "formal"; icon: string; name: Localized; when: Localized };
 type Words = { ko: string; roman: string };
 type Example = { id: string; meaning: Localized; casual: Words; polite: Words; formal: Words };
+type TextItem = { ko: string; read: string; level: "any" | "polite" | "casual"; meaning: Localized };
+
+// 메신저 줄임말: 누구에게 보내도 되는지 표시 색
+const TEXT_BADGE: Record<TextItem["level"], string> = {
+  any: "bg-bg",
+  polite: "bg-brand-soft",
+  casual: "bg-bg text-muted",
+};
 
 // 말투별 색 (해요체 = 가장 무난해서 강조)
 const TONE: Record<Level["id"], string> = {
@@ -29,6 +37,8 @@ export default async function Page({ params }: PageProps<"/[lang]/tools/korean-p
   const ui = content.ui;
   const levels = data.levels as Level[];
   const examples = data.examples as Example[];
+  const texting = data.texting.items as TextItem[];
+  const levelLabel = { any: ui.levelAny, polite: ui.levelPolite, casual: ui.levelCasual };
 
   return (
     <ToolLayout lang={lang} slug={SLUG} about={content.about} faq={content.faq} sources={[]}>
@@ -79,6 +89,32 @@ export default async function Page({ params }: PageProps<"/[lang]/tools/korean-p
             ))}
           </ul>
         </section>
+
+        {/* 카톡·문자 줄임말 (ㅋㅋ, ㅇㅇ, 넵…) */}
+        <section className="space-y-2">
+          <h2 className="text-lg font-bold">{ui.texting}</h2>
+          <p className="text-sm text-muted">{ui.textingNote}</p>
+          <ul className="grid gap-2 sm:grid-cols-2">
+            {texting.map((t) => (
+              <li key={t.ko} className="rounded-2xl border border-line bg-card p-3">
+                <div className="flex items-center gap-2">
+                  <span lang="ko" className="text-lg font-bold">
+                    {t.ko}
+                  </span>
+                  {t.read && t.read !== t.ko && (
+                    <span lang="ko" className="text-sm text-muted">
+                      = {t.read}
+                    </span>
+                  )}
+                  <span className={`ml-auto shrink-0 rounded-full border border-line px-2 py-0.5 text-xs font-semibold ${TEXT_BADGE[t.level]}`}>
+                    {levelLabel[t.level]}
+                  </span>
+                </div>
+                <p className="mt-1 text-sm">{pick(t.meaning, lang)}</p>
+              </li>
+            ))}
+          </ul>
+        </section>
       </div>
     </ToolLayout>
   );
