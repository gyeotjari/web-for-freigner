diff --git a/lib/speech.ts b/lib/speech.ts
index 183bcc4..45eb073 100644
--- a/lib/speech.ts
+++ b/lib/speech.ts
@@ -3,12 +3,24 @@ export function canSpeak() {
   return typeof window !== "undefined" && "speechSynthesis" in window;
 }
 
-// rate: 보통 0.9, 느리게 듣기(🐢)는 0.6
-export function speakKorean(text: string, rate = 0.9) {
+// 같은 말을 5초 안에 다시 누르면 느리게(0.6) 읽어줘요. (번역 앱처럼 "한 번 더 = 천천히")
+// 그다음에 또 누르면 다시 보통 속도. 사이트의 모든 🔊 버튼에 똑같이 적용돼요.
+const REPEAT_MS = 5000;
+let last: { text: string; at: number; slow: boolean } | null = null;
+
+// rate: 보통 0.9, 느리게 듣기(🐢)는 0.6. rate를 직접 주면 그 속도로만 읽어요.
+export function speakKorean(text: string, rate?: number) {
   if (!canSpeak()) return;
+  const now = Date.now();
+  let r = rate ?? 0.9;
+  if (rate === undefined) {
+    const repeat = last !== null && last.text === text && now - last.at < REPEAT_MS && !last.slow;
+    if (repeat) r = 0.6;
+    last = { text, at: now, slow: repeat };
+  }
   const u = new SpeechSynthesisUtterance(text);
   u.lang = "ko-KR";
-  u.rate = rate;
+  u.rate = r;
   const koVoice = window.speechSynthesis.getVoices().find((v) => v.lang.startsWith("ko"));
   if (koVoice) u.voice = koVoice;
   window.speechSynthesis.cancel();
