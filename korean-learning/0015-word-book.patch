@@ -259,11 +281,16 @@ function MenuWords({ ui, words, isClient }: { ui: Ui; words: MenuWord[]; isClien
       <ul className="mt-2 grid grid-cols-2 gap-2">
         {words.map((w) => (
           <li key={w.id} className="rounded-lg border border-line p-2">
-            <p>
