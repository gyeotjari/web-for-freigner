             <p className="text-sm">{w.meaning}</p>
             <button
@@ -362,3 +389,54 @@ function MenuListenQuiz({ ui, words }: { ui: Ui; words: MenuWord[] }) {
     </div>
   );
 }
+
+// 내 단어장: ☆ 누른 단어만 모아서 다시 듣기. 저장한 게 없으면 안 보여요. 휴대폰에서 길어지지 않게 접어 둬요.
+function WordBook({
+  ui,
+  saved,
+  signs,
+  menuWords,
+  toggle,
+}: {
+  ui: Ui;
+  saved: string[];
+  signs: Sign[];
+  menuWords: MenuWord[];
+  toggle: (key: string) => void;
+}) {
+  const items = saved
+    .map((key) => {
+      const [kind, id] = key.split(":");
+      if (kind === "s") {
+        const s = signs.find((x) => x.id === id);
+        return s && { key, ko: s.ko, roman: s.roman, meaning: s.meaning, say: s.ko };
+      }
+      const m = menuWords.find((x) => x.id === id);
+      return m && { key, ko: m.ko, roman: m.roman, meaning: m.meaning, say: m.example };
+    })
+    .filter((x) => !!x);
+  if (items.length === 0) return null;
+  return (
+    <details className="rounded-xl border-2 border-accent bg-card p-3">
+      <summary className="cursor-pointer font-bold">
+        ★ {ui.wordBookTitle} ({items.length})
+      </summary>
+      <ul className="mt-2 space-y-1">
+        {items.map((w) => (
+          <li key={w.key} className="flex items-center gap-2 rounded-lg bg-bg px-3 py-2">
+            <button type="button" onClick={() => speakKorean(w.say)} className="flex flex-1 items-center gap-2 text-left">
+              <span aria-hidden>🔊</span>
+              <span lang="ko" className="font-bold">
+                {w.ko}
+              </span>
+              <span className="text-sm">{w.meaning}</span>
+            </button>
+            <button type="button" onClick={() => toggle(w.key)} aria-label={ui.unsaveWord} className="text-sm text-muted">
+              ✕
+            </button>
+          </li>
+        ))}
+      </ul>
+    </details>
+  );
+}
