-type Level = "easy" | "medium" | "hard" | "native" | "time" | "date";
+type Level = "easy" | "medium" | "hard" | "native" | "time" | "date" | "day";
 // 문제 하나: parts = 정답 숫자들(입력칸 하나에 하나씩), units = 각 입력칸 옆 단위, text = 읽어 주는 한국어
 // 가격·세기는 칸 1개, 시간(시·분)·날짜(월·일)는 칸 2개예요.
 type Q = { parts: number[]; units: string[]; text: string };
 const PRICE_LEVELS = ["easy", "medium", "hard"] as const;
+// 요일: 월요일부터 일요일까지. 들은 요일을 보기 7개 중에서 골라요.
+const DAYS_KO = ["월요일", "화요일", "수요일", "목요일", "금요일", "토요일", "일요일"];
 type PriceLevel = (typeof PRICE_LEVELS)[number];
 
 // 단계별로 실제 가격처럼 보이는 숫자를 만들어요. (step 단위로 끊어서)
@@ -39,6 +41,10 @@ function randomQ(level: Level, won: string): Q {
     const d = randomDate();
     return { parts: [d.m, d.d], units: ["월", "일"], text: d.text };
   }
+  if (level === "day") {
+    const i = Math.floor(Math.random() * DAYS_KO.length);
+    return { parts: [i], units: [], text: DAYS_KO[i] };
+  }
   const { min, max, step } = RANGES[level];
   const count = Math.floor((max - min) / step) + 1;
   const n = min + Math.floor(Math.random() * count) * step;
@@ -46,7 +52,8 @@ function randomQ(level: Level, won: string): Q {
 }
 
 // 틀렸을 때 보여 줄 정답: 가격은 1,000처럼, 나머지는 "3시 20분"처럼
-function answerText(level: Level, q: Q) {
+function answerText(level: Level, q: Q, days: readonly string[]) {
+  if (level === "day") return days[q.parts[0]];
   if ((PRICE_LEVELS as readonly string[]).includes(level)) return formatNumber(q.parts[0]);
   if (q.parts.length === 1) return String(q.parts[0]);
   return q.parts.map((p, i) => `${p}${q.units[i]}`).join(" ");
@@ -75,6 +82,15 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
     setStreak(ok ? streak + 1 : 0);
   }
 
+  // 요일 단계: 보기를 누르면 바로 채점해요
+  function choose(i: number) {
+    if (price === null || result !== null) return;
+    const ok = price.parts[0] === i;
+    setGuess([String(i)]);
+    setResult(ok ? "right" : "wrong");
+    setStreak(ok ? streak + 1 : 0);
+  }
+
   function next() {
     const n = randomQ(level, ui.won);
     setPrice(n);
@@ -84,9 +100,18 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
   }
 
   const isPrice = (PRICE_LEVELS as readonly string[]).includes(level);
-  const playLabel = level === "time" ? ui.playTime : level === "date" ? ui.playDate : level === "native" ? ui.playCount : ui.play;
+  const playLabel =
+    level === "time" ? ui.playTime : level === "date" ? ui.playDate : level === "day" ? ui.playDay : level === "native" ? ui.playCount : ui.play;
   const answerLabel =
-    level === "time" ? ui.answerTime : level === "date" ? ui.answerDate : level === "native" ? ui.answerCount : ui.answer;
+    level === "time"
+      ? ui.answerTime
+      : level === "date"
+        ? ui.answerDate
+        : level === "day"
+          ? ui.answerDay
+          : level === "native"
+            ? ui.answerCount
+            : ui.answer;
 
   return (
     <div className="space-y-4">
@@ -113,6 +138,27 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
         <div className="space-y-3 rounded-2xl border border-line bg-card p-4">
           <fieldset>
             <legend className="mb-1 block font-semibold">{answerLabel}</legend>
+            {level === "day" && (
+              <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
+                {ui.days.map((d, i) => {
+                  const picked = guess[0] === String(i);
+                  const isAnswer = result !== null && price.parts[0] === i;
+                  return (
+                    <button
+                      key={d}
+                      type="button"
+                      onClick={() => choose(i)}
+                      disabled={result !== null}
+                      className={`rounded-xl border-2 px-3 py-3 font-semibold ${
+                        isAnswer ? "border-ok bg-ok/10" : picked ? "border-warn-ink bg-warn-bg" : "border-line"
+                      }`}
+                    >
+                      {d}
+                    </button>
+                  );
+                })}
+              </div>
+            )}
             <div className="flex gap-2">
               {price.units.map((unit, i) => (
                 <span key={i} className="flex min-w-0 flex-1 items-center rounded-xl border-2 border-line focus-within:border-brand">
@@ -134,14 +180,16 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
           </fieldset>
 
           {result === null ? (
-            <button type="button" onClick={check} className="w-full rounded-xl bg-ink py-3 font-semibold text-card">
-              {ui.check}
-            </button>
+            level !== "day" && (
+              <button type="button" onClick={check} className="w-full rounded-xl bg-ink py-3 font-semibold text-card">
+                {ui.check}
+              </button>
+            )
           ) : (
             <div aria-live="polite" className="space-y-3">
               <div className={`rounded-xl p-3 ${result === "right" ? "bg-ok/10" : "bg-warn-bg"}`}>
                 <p className="font-bold">
-                  {result === "right" ? ui.correct : (isPrice ? ui.wrong : ui.wrongCount).replace("{n}", answerText(level, price))}
+                  {result === "right" ? ui.correct : (isPrice ? ui.wrong : ui.wrongCount).replace("{n}", answerText(level, price, ui.days))}
                 </p>
                 <p className="mt-1 text-sm">
                   {ui.reading}:{" "}
