@@ -74,7 +74,7 @@ export function HangulReader({
 
       <SoundRules ui={ui} rules={soundRules} />
 
-      <MenuWords ui={ui} words={menuWords} />
+      <MenuWords ui={ui} words={menuWords} isClient={isClient} />
 
       <section className="rounded-2xl border border-line bg-card p-4">
         <h2 className="mb-3 text-lg font-bold">🔤 {ui.quizTitle}</h2>
@@ -251,7 +251,7 @@ function SoundRules({ ui, rules }: { ui: Ui; rules: SoundRule[] }) {
 
 // 메뉴판 읽기: 음식 이름 끝의 요리 방법(볶음·구이·찌개…) 12개. 예시 음식을 누르면 들려요.
 // 휴대폰에서 길어지지 않게 접어 둬요.
-function MenuWords({ ui, words }: { ui: Ui; words: MenuWord[] }) {
+function MenuWords({ ui, words, isClient }: { ui: Ui; words: MenuWord[]; isClient: boolean }) {
   return (
     <details className="rounded-xl border border-line bg-card p-3">
       <summary className="cursor-pointer font-bold">🍲 {ui.menuTitle}</summary>
@@ -276,6 +276,89 @@ function MenuWords({ ui, words }: { ui: Ui; words: MenuWord[] }) {
           </li>
         ))}
       </ul>
+      {/* 문제 순서는 무작위라서 브라우저에서만 만들어요 */}
+      {isClient && words.length >= 4 && <MenuListenQuiz ui={ui} words={words} />}
     </details>
   );
 }
+
+// 메뉴판 듣기 퀴즈: 음식 이름(김치찌개)을 듣고 어떤 조각(찌개)이 들어 있는지 고르기. (그림 카드 단어 앱 방식)
+// 김치볶음밥처럼 조각이 두 개 들어간 음식이 있어서, 들은 음식 이름에 들어 있는 다른 조각은 보기에서 빼요.
+function pickMenuQ(words: MenuWord[]) {
+  const w = words[Math.floor(Math.random() * words.length)];
+  const pool = words.filter((o) => o.id === w.id || !w.example.includes(o.ko)).map((o) => o.ko);
+  return { w, choices: makeChoices(w.ko, pool) };
+}
+
+function MenuListenQuiz({ ui, words }: { ui: Ui; words: MenuWord[] }) {
+  const [q, setQ] = useState(() => pickMenuQ(words));
+  const [picked, setPicked] = useState<string | null>(null);
+  const [score, setScore] = useState(0);
+  const [answered, setAnswered] = useState(0);
+
+  function answer(c: string) {
+    if (picked) return;
+    setPicked(c);
+    setAnswered(answered + 1);
+    if (c === q.w.ko) setScore(score + 1);
+  }
+
+  function next() {
+    const n = pickMenuQ(words);
+    setQ(n);
+    setPicked(null);
+    speakKorean(n.w.example);
+  }
+
+  return (
+    <div className="mt-3 space-y-2 border-t border-line pt-3">
+      <p className="font-semibold">
+        🎧 {ui.menuQuizTitle}{" "}
+        <span className="text-sm font-normal text-muted">
+          ({ui.score}: {score} / {answered})
+        </span>
+      </p>
+      <p className="text-sm">{ui.menuQuizQuestion}</p>
+      <button
+        type="button"
+        onClick={() => speakKorean(q.w.example)}
+        aria-label={ui.listen}
+        className="w-full rounded-xl bg-ink py-4 text-2xl text-card"
+      >
+        🔊{" "}
+        {picked && (
+          <span lang="ko" className="font-bold">
+            {q.w.example}
+          </span>
+        )}
+      </button>
+      <div className="grid grid-cols-4 gap-2">
+        {q.choices.map((c) => {
+          const state = !picked ? "" : c === q.w.ko ? "border-ok bg-ok/10" : c === picked ? "border-accent bg-warn-bg" : "opacity-60";
+          return (
+            <button
+              key={c}
+              type="button"
+              lang="ko"
+              onClick={() => answer(c)}
+              className={`rounded-xl border-2 border-line bg-card py-3 text-lg font-bold ${state}`}
+            >
+              {c}
+            </button>
+          );
+        })}
+      </div>
+      {picked && (
+        <div aria-live="polite" className="space-y-2">
+          <p className="text-sm font-semibold">
+            {picked === q.w.ko ? ui.correct : ui.wrong.replace("{answer}", q.w.ko)}{" "}
+            <span className="font-normal text-muted">({q.w.meaning})</span>
+          </p>
+          <button type="button" onClick={next} className="w-full rounded-xl bg-brand px-4 py-2 font-semibold text-brand-ink">
+            {ui.next} →
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
