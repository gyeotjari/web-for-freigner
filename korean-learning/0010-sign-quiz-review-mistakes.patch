+++ b/app/[lang]/tools/hangul-reader/HangulReader.tsx
@@ -81,12 +81,17 @@ export function HangulReader({
 }
 
 function SignQuiz({ ui, signs }: { ui: Ui; signs: Sign[] }) {
-  const [order] = useState(() => shuffle(signs));
+  const [order, setOrder] = useState(() => shuffle(signs));
   const [index, setIndex] = useState(0);
   const [picked, setPicked] = useState<string | null>(null);
   const [streak, setStreak] = useState(0);
   const [score, setScore] = useState(0);
+  const [answered, setAnswered] = useState(0);
   const [best, setBest] = useStoredJSON("kt:hangul:best", 0);
+  // 틀린 간판 id를 이 기기에만 저장해요. 맞히면 목록에서 빠져요. (단어 앱의 "틀린 것 복습")
+  const [missed, setMissed] = useStoredJSON<string[]>("kt:hangul:missed", []);
+  const [review, setReview] = useState(false);
+  const missedSigns = signs.filter((s) => missed.includes(s.id));
 
   const sign = order[index % order.length];
   const [choices, setChoices] = useState(() => makeChoices(sign.meaning, signs.map((s) => s.meaning)));
@@ -94,28 +99,66 @@ function SignQuiz({ ui, signs }: { ui: Ui; signs: Sign[] }) {
   function answer(choice: string) {
     if (picked) return;
     setPicked(choice);
+    setAnswered(answered + 1);
     if (choice === sign.meaning) {
       const s = streak + 1;
       setStreak(s);
       setScore(score + 1);
       if (s > best) setBest(s);
+      if (missed.includes(sign.id)) setMissed(missed.filter((id) => id !== sign.id));
     } else {
       setStreak(0);
+      if (!missed.includes(sign.id)) setMissed([...missed, sign.id]);
     }
   }
 
+  function start(list: Sign[], isReview: boolean) {
+    const o = shuffle(list);
+    setOrder(o);
+    setReview(isReview);
+    setIndex(0);
+    setPicked(null);
+    setChoices(makeChoices(o[0].meaning, signs.map((s) => s.meaning)));
+  }
+
   function next() {
+    // 복습 중: 한 바퀴 돌면 아직 남은 틀린 것만 다시, 다 맞혔으면 전체 문제로 돌아가요.
+    if (review && index + 1 >= order.length) {
+      if (missedSigns.length > 0) start(missedSigns, true);
+      else start(signs, false);
+      return;
+    }
     const nextSign = order[(index + 1) % order.length];
     setIndex(index + 1);
     setPicked(null);
     setChoices(makeChoices(nextSign.meaning, signs.map((s) => s.meaning)));
   }
 
+  const reviewBar = review ? (
+    <div className="flex items-center justify-between gap-2 rounded-xl bg-warn-bg px-3 py-2 text-sm">
+      <span>
+        🔁 {ui.reviewing} ({Math.min(index + 1, order.length)} / {order.length})
+      </span>
+      <button type="button" onClick={() => start(signs, false)} className="rounded-lg border border-line bg-card px-2 py-1">
+        {ui.reviewStop}
+      </button>
+    </div>
+  ) : missedSigns.length > 0 && !picked ? (
+    <button
+      type="button"
+      onClick={() => start(missedSigns, true)}
+      className="w-full rounded-xl border-2 border-accent px-3 py-2 text-sm font-semibold"
+    >
+      🔁 {ui.reviewButton.replace("{n}", String(missedSigns.length))}
+    </button>
+  ) : null;
+
   return (
     <div className="space-y-3">
       <p className="text-sm text-muted">
-        {ui.score}: {score} / {index + (picked ? 1 : 0)} · {ui.best}: {best}
+        {ui.score}: {score} / {answered} · {ui.best}: {best}
       </p>
+      {reviewBar}
       <p className="text-sm font-semibold">{ui.question}</p>
       <div className="flex items-center justify-center gap-3 rounded-2xl bg-ink py-6 text-card">
         <span lang="ko" className="text-4xl font-bold tracking-wide">
