diff --git a/lib/korean-time.ts b/lib/korean-time.ts
new file mode 100644
index 0000000..3cbeb6c
--- /dev/null
+++ b/lib/korean-time.ts
@@ -0,0 +1,44 @@
+// 시각·날짜 읽기 연습용. 시(時)는 고유어 수(세 시), 분·월·일은 한자어 수(이십 분, 십일월 십이 일)로 읽어요.
+// 6월·10월은 받침이 빠져 "유월", "시월"이라고 읽어요 (육월·십월 X).
+import { numberToKorean } from "@/lib/korean-number";
+import { nativeKorean } from "@/lib/native-number";
+
+const pick = (max: number) => Math.floor(Math.random() * max);
+
+// 정답 parts: 시간 [시, 분], 날짜 [월, 일]
+export type TimeQ = { parts: number[]; text: string; shown: string };
+
+export function readTime(h: number, m: number, useBan = false): string {
+  const hour = `${nativeKorean(h, true)} 시`;
+  if (m === 0) return hour;
+  if (m === 30 && useBan) return `${hour} 반`;
+  return `${hour} ${numberToKorean(m)} 분`;
+}
+
+export function randomTime(): TimeQ {
+  const h = 1 + pick(12);
+  const m = pick(12) * 5; // 0, 5, 10 … 55분
+  return { parts: [h, m], text: readTime(h, m, Math.random() < 0.5), shown: `${h}:${String(m).padStart(2, "0")}` };
+}
+
+export function readMonth(mo: number): string {
+  if (mo === 6) return "유월";
+  if (mo === 10) return "시월";
+  return `${numberToKorean(mo)}월`;
+}
+
+const DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+export function randomDate(): TimeQ {
+  // 유월·시월이 자주 나오게 1/4 확률로 둘 중 하나
+  const mo = Math.random() < 0.25 ? (Math.random() < 0.5 ? 6 : 10) : 1 + pick(12);
+  const d = 1 + pick(DAYS[mo - 1]);
+  return { parts: [mo, d], text: `${readMonth(mo)} ${numberToKorean(d)} 일`, shown: `${mo}/${d}` };
+}
+
+// "3:20", "3 20", "3시 20분", "11/12" 모두 받아요. 숫자 묶음만 비교. 정각은 "3"만 써도 맞아요.
+export function matchParts(guess: string, parts: number[]): boolean {
+  const got = (guess.match(/\d+/g) ?? []).map(Number);
+  if (got.length === 1 && parts.length === 2 && parts[1] === 0 && parts[0] !== 0) return got[0] === parts[0];
+  return got.length === parts.length && got.every((v, i) => v === parts[i]);
+}
