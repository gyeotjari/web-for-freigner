diff --git a/lib/native-number.ts b/lib/native-number.ts
index 72a74d4..82ca4f5 100644
--- a/lib/native-number.ts
+++ b/lib/native-number.ts
@@ -30,3 +30,47 @@ export function randomCount() {
   const n = 1 + Math.floor(Math.random() * c.max);
   return { counter: c, n, text: `${nativeKorean(n, true)} ${c.ko}` };
 }
+
+// ── 시간·날짜 읽기 ──
+// 시각: 시는 고유어(세 시), 분은 한자어(이십 분). 30분은 "반"이라고도 해요.
+// 날짜: 월·일 모두 한자어. 6월 = 유월, 10월 = 시월 (한글 맞춤법 제52항, 소리 나는 대로 적는 말).
+export function sinoKorean(n: number): string {
+  // 1~99 한자어 수 (분·월·일용). 십 앞의 '일'은 읽지 않아요.
+  const D = ["", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구"];
+  const t = Math.floor(n / 10);
+  const o = n % 10;
+  return (t === 0 ? "" : (t === 1 ? "" : D[t]) + "십") + D[o];
+}
+
+export function monthKorean(m: number): string {
+  if (m === 6) return "유월";
+  if (m === 10) return "시월";
+  return sinoKorean(m) + "월";
+}
+
+export function timeKorean(h: number, min: number, useBan = false): string {
+  const hour = `${nativeKorean(h, true)} 시`;
+  if (min === 0) return hour;
+  if (min === 30 && useBan) return `${hour} 반`;
+  return `${hour} ${sinoKorean(min)} 분`;
+}
+
+export function dateKorean(m: number, d: number): string {
+  return `${monthKorean(m)} ${sinoKorean(d)}일`;
+}
+
+const MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+export function randomTime() {
+  const h = 1 + Math.floor(Math.random() * 12);
+  const min = Math.floor(Math.random() * 12) * 5; // 5분 단위
+  const useBan = min === 30 && Math.random() < 0.5;
+  return { h, min, text: timeKorean(h, min, useBan) };
+}
+
+export function randomDate() {
+  // 6월·10월(유월·시월)이 헷갈리니 조금 더 자주 나오게 해요
+  const m = Math.random() < 0.3 ? (Math.random() < 0.5 ? 6 : 10) : 1 + Math.floor(Math.random() * 12);
+  const d = 1 + Math.floor(Math.random() * MONTH_DAYS[m - 1]);
+  return { m, d, text: dateKorean(m, d) };
+}
