@@ -0,0 +1,43 @@
+// 시각(○시 ○분)과 날짜(○월 ○일)를 한국어로 읽어요.
+// - 시는 고유어 수(한 시, 두 시…), 분은 한자어 수(이십 분)예요. 30분은 "반"이라고도 해요.
+// - 월·일은 한자어 수예요. 6월은 "유월", 10월은 "시월"로 읽어요 (육월·십월 X).
+import { nativeKorean } from "./native-number";
+import { numberToKorean } from "./korean-number";
+
+export function timeKorean(hour: number, minute: number, useBan = false): string {
+  if (!Number.isInteger(hour) || hour < 1 || hour > 12) throw new RangeError("hour: 1-12");
+  if (!Number.isInteger(minute) || minute < 0 || minute > 59) throw new RangeError("minute: 0-59");
+  const h = `${nativeKorean(hour, true)} 시`;
+  if (minute === 0) return h;
+  if (minute === 30 && useBan) return `${h} 반`;
+  return `${h} ${numberToKorean(minute)} 분`;
+}
+
+const MONTH_SPECIAL: Record<number, string> = { 6: "유월", 10: "시월" };
+
+export function monthKorean(month: number): string {
+  if (!Number.isInteger(month) || month < 1 || month > 12) throw new RangeError("month: 1-12");
+  return MONTH_SPECIAL[month] ?? `${numberToKorean(month)}월`;
+}
+
+export function dateKorean(month: number, day: number): string {
+  return `${monthKorean(month)} ${numberToKorean(day)} 일`;
+}
+
+const DAYS_IN_MONTH = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+// 연습 문제: 시각은 5분 단위(실제 예약·약속 시간처럼), 날짜는 그 달에 있는 날만
+export function randomTime() {
+  const hour = 1 + Math.floor(Math.random() * 12);
+  const minute = Math.floor(Math.random() * 12) * 5;
+  const text = timeKorean(hour, minute, minute === 30 && Math.random() < 0.5);
+  return { parts: [hour, minute] as [number, number], text };
+}
+
+export function randomDate() {
+  const month = 1 + Math.floor(Math.random() * 12);
+  // 6월·10월(읽는 법이 다른 달)을 조금 더 자주 내요
+  const m = Math.random() < 0.25 ? (Math.random() < 0.5 ? 6 : 10) : month;
+  const day = 1 + Math.floor(Math.random() * DAYS_IN_MONTH[m - 1]);
+  return { parts: [m, day] as [number, number], text: dateKorean(m, day) };
+}
