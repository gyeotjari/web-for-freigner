diff --git a/lib/native-number.ts b/lib/native-number.ts
new file mode 100644
index 0000000..72a74d4
--- /dev/null
+++ b/lib/native-number.ts
@@ -0,0 +1,32 @@
+// 고유어 수(하나, 둘, 셋…)를 만들어요. 물건 세기·사람 수·시각(○시)·나이에 써요. 1~99만 있어요.
+// 단위(개·명·시·살…) 앞에서는 줄어든 꼴을 써요: 하나→한, 둘→두, 셋→세, 넷→네, 스물→스무 (스무 개, 스물한 개).
+const ONES = ["", "하나", "둘", "셋", "넷", "다섯", "여섯", "일곱", "여덟", "아홉"];
+const ONES_BEFORE_UNIT = ["", "한", "두", "세", "네", "다섯", "여섯", "일곱", "여덟", "아홉"];
+const TENS = ["", "열", "스물", "서른", "마흔", "쉰", "예순", "일흔", "여든", "아흔"];
+
+export function nativeKorean(n: number, beforeUnit = false): string {
+  if (!Number.isInteger(n) || n < 1 || n > 99) throw new RangeError("native numbers: 1-99 only");
+  const t = Math.floor(n / 10);
+  const o = n % 10;
+  if (o === 0) return beforeUnit && t === 2 ? "스무" : TENS[t];
+  return TENS[t] + (beforeUnit ? ONES_BEFORE_UNIT[o] : ONES[o]);
+}
+
+// 연습에 쓰는 단위. max는 실제로 자주 듣는 범위예요 (시는 1~12시).
+export const COUNTERS = [
+  { id: "items", ko: "개", max: 20 },
+  { id: "people", ko: "명", max: 20 },
+  { id: "hour", ko: "시", max: 12 },
+  { id: "age", ko: "살", max: 99 },
+  { id: "cups", ko: "잔", max: 10 },
+  { id: "bottles", ko: "병", max: 10 },
+  { id: "sheets", ko: "장", max: 20 },
+] as const;
+
+export type CounterId = (typeof COUNTERS)[number]["id"];
+
+export function randomCount() {
+  const c = COUNTERS[Math.floor(Math.random() * COUNTERS.length)];
+  const n = 1 + Math.floor(Math.random() * c.max);
+  return { counter: c, n, text: `${nativeKorean(n, true)} ${c.ko}` };
+}
