diff --git a/lib/quiz-reading.ts b/lib/quiz-reading.ts
new file mode 100644
index 0000000..9478710
--- /dev/null
+++ b/lib/quiz-reading.ts
@@ -0,0 +1,39 @@
+import { numberToKorean } from "./korean-number";
+import { nativeKorean } from "./native-number";
+import { shuffle } from "./quiz";
+import { timeKorean } from "./time-date-korean";
+
+// 고유어 수 문제: "2명"·"3:20"을 어떻게 읽는지. 한자어 수와 섞은 오답을 보기로 넣어요.
+const COUNT_ITEMS = [
+  { unit: "개", max: 10 },
+  { unit: "명", max: 10 },
+  { unit: "살", max: 40 },
+  { unit: "잔", max: 5 },
+  { unit: "병", max: 5 },
+];
+
+// 정답 + 겹치지 않는 오답 3개
+function pick(answer: string, wrong: string[], rand: () => number) {
+  const others = [...new Set(wrong)].filter((w) => w !== answer).slice(0, 3);
+  return shuffle([answer, ...others], rand);
+}
+
+export function readingQuestion(rand: () => number) {
+  if (rand() < 0.5) {
+    const c = COUNT_ITEMS[Math.floor(rand() * COUNT_ITEMS.length)];
+    const n = 1 + Math.floor(rand() * c.max);
+    const answer = `${nativeKorean(n, true)} ${c.unit}`;
+    const other = n < c.max ? n + 1 : n - 1;
+    // 한자어로 읽기(이 명), 숫자 틀리기, 줄어든 꼴 안 쓰기(하나 개) — 흔한 실수 순서로 골라요
+    const wrong = [`${numberToKorean(n)} ${c.unit}`, `${nativeKorean(other, true)} ${c.unit}`, `${nativeKorean(n)} ${c.unit}`, `${numberToKorean(other)} ${c.unit}`];
+    return { type: "reading" as const, prompt: `${n}${c.unit}`, answer, choices: pick(answer, wrong, rand) };
+  }
+  const h = 1 + Math.floor(rand() * 12);
+  const m = (1 + Math.floor(rand() * 11)) * 5;
+  const answer = timeKorean(h, m);
+  const sinoHour = `${numberToKorean(h)} 시 ${numberToKorean(m)} 분`; // 시를 한자어로 읽는 흔한 실수
+  const nativeMin = `${nativeKorean(h, true)} 시 ${nativeKorean(m, true)} 분`; // 분까지 고유어로 읽는 실수
+  const otherHour = timeKorean(h === 12 ? 11 : h + 1, m);
+  const wrong = [sinoHour, nativeMin, otherHour];
+  return { type: "reading" as const, prompt: `${h}:${String(m).padStart(2, "0")}`, answer, choices: pick(answer, wrong, rand) };
+}
