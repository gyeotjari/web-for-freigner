+// 단계별 최근 결과 10개 (true = 맞힘, 이 기기에만 저장). 최근에 많이 틀린 단계를 "다시 연습"으로 추천해요.
+// 최근 10개만 보니까, 다시 연습해서 맞히면 추천에서 저절로 빠져요.
+type Stats = Partial<Record<Level, boolean[]>>;
+const RECENT = 10;
+const MIN_TRIES = 3; // 3문제 이상 푼 단계만 추천 (한두 문제로는 판단하지 않아요)
+
+function weakestLevel(stats: Stats, current: Level): { level: Level; wrong: number; tries: number } | null {
+  let best: { level: Level; wrong: number; tries: number } | null = null;
+  for (const [lv, recent] of Object.entries(stats) as [Level, boolean[]][]) {
+    const tries = recent.length;
+    const wrong = recent.filter((ok) => !ok).length;
+    if (lv === current || tries < MIN_TRIES || wrong / tries < 0.3) continue;
+    if (!best || wrong / tries > best.wrong / best.tries) best = { level: lv, wrong, tries };
+  }
+  return best;
+}
+
 function randomQ(level: Level, won: string): Q {
   if (level === "native") {
     // 고유어 수: "사과 세 개"처럼 물건·사람·시각·나이를 세는 말
@@ -65,6 +82,20 @@ export function NumbersPractice({ ui }: { ui: ToolUi<"korean-numbers"> }) {
   const [guess, setGuess] = useState<string[]>([]);
   const [result, setResult] = useState<"right" | "wrong" | null>(null);
   const [streak, setStreak] = useState(0);
+  const [stats, setStats] = useStoredJSON<Stats>("kt:numbers:stats", {});
+
+  function record(ok: boolean) {
+    setStreak(ok ? streak + 1 : 0);
+    setStats({ ...stats, [level]: [...(stats[level] ?? []), ok].slice(-RECENT) });
+  }
+
+  function changeLevel(v: Level) {
+    setLevel(v);
+    setPrice(null);
+    setGuess([]);
+    setResult(null);
+  }
+  const weak = weakestLevel(stats, level);
 
   const say = (q: Q) => speakKorean(q.text);
 
