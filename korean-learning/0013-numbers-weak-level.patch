     // 분 칸을 비워 두면 0분(예: "세 시" = 3시 0분)으로 봐요
     const ok = price.parts.every((p, i) => Number((guess[i] ?? "").replace(/[^0-9]/g, "") || "0") === p);
     setResult(ok ? "right" : "wrong");
